#!/bin/sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ ! -f package.json ]; then
  echo "pre-commit: package.json was not found, so npm validation cannot run." >&2
  echo "pre-commit: expected scripts: lint, build, test." >&2
  exit 1
fi

run_check() {
  name="$1"
  echo "pre-commit: running npm run $name"
  npm run "$name"
}

run_check lint
run_check build
run_check test

if python3 -m pytest --version >/dev/null 2>&1; then
  echo "pre-commit: running python3 -m pytest"
  python3 -m pytest scripts/test_execute.py -q
else
  echo "pre-commit: pytest not found — skipping Python tests (run: pip3 install pytest)" >&2
fi

echo "pre-commit: all checks passed"
